# Copy to .env. This example contains no credentials.
PORT=8787
OPERAOS_STATE_DIR=.runtime
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
OPERAOS_ENCRYPTION_KEY=
# Dedicated demonstration endpoints only. Never connect production records.
MTG_ENDPOINT_URL=
MTG_TOKEN=
QAHE_ENDPOINT_URL=
QAHE_STATUS_ENDPOINT_URL=
QAHE_TOKEN=

# First-boot owner only; public registration can never create an owner.
OPERAOS_OWNER_EMAIL=
OPERAOS_OWNER_PASSWORD=
# Optional secrets for self-registered organisation IDs (JSON object keyed by workspace ID).
# Example shape: {"WORKSPACE_ID":{"endpoint":"HTTPS_TEST_ENDPOINT","token":"PRIVATE_TOKEN","statusEndpoint":"OPTIONAL_HTTPS_STATUS_ENDPOINT"}}
OPERAOS_CONNECTIONS_JSON={}

# Optional provider tokens (backend only). Refresh/consent is configured externally.
MTG_GOOGLE_ACCESS_TOKEN=
QAHE_GOOGLE_ACCESS_TOKEN=
MTG_GRAPH_ACCESS_TOKEN=
QAHE_GRAPH_ACCESS_TOKEN=
# New organisation providers: OPERAOS_CONNECTIONS_JSON entries can also include
# googleAccessToken and graphAccessToken. Keep actual tokens out of Git.

# Optional first-boot owner display name; existing owners edit their profile in settings.
OPERAOS_OWNER_NAME=
# HTTPS origin behind a trusted reverse proxy; blank keeps local-only origin.
OPERAOS_PUBLIC_ORIGIN=
# Private historical file override (never commit personal data).
OPERAOS_MTG_HISTORY_FILE=
# New expense organisation credentials: use its UUID in OPERAOS_CONNECTIONS_JSON,
# e.g. {"ORGANISATION_UUID":{"graphAccessToken":"BACKEND_ONLY_DELEGATED_TOKEN"}}
# Delegated Microsoft work/school credentials are required. No automatic token refresh.
